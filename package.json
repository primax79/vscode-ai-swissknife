{
  "name": "ai-swissknife",
  "displayName": "AI Swissknife",
  "description": "Cross-assistant marketplace and management for custom skill/agent/mcp/rule repositories (Claude Code, Kilo Code, and more).",
  "version": "0.0.1",
  "publisher": "AlfredoOliviero",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/primax79/vscode-ai-swissknife.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-swissknife",
          "title": "AI Swissknife",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-swissknife": [
        {
          "id": "aiSwissknife.sources",
          "name": "Sources"
        },
        {
          "id": "aiSwissknife.available",
          "name": "Available"
        },
        {
          "id": "aiSwissknife.installed",
          "name": "Installed"
        }
      ]
    },
    "commands": [
      {
        "command": "aiSwissknife.addSource",
        "title": "Add Source",
        "icon": "$(plus)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.removeSource",
        "title": "Remove Source",
        "icon": "$(trash)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.reloadRegistry",
        "title": "Reload Manifest",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.refreshCatalog",
        "title": "Refresh Available Catalog",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installArtifact",
        "title": "Install Skill",
        "icon": "$(cloud-download)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installFolder",
        "title": "Install All in Folder",
        "icon": "$(cloud-download)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installSourceGroup",
        "title": "Install All in Source",
        "icon": "$(cloud-download)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.refreshInstalled",
        "title": "Refresh Installed",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.checkDrift",
        "title": "Check Drift & Updates",
        "icon": "$(sync)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.updateItem",
        "title": "Update to Latest Version",
        "icon": "$(arrow-circle-up)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.promoteItem",
        "title": "Promote to Managed",
        "icon": "$(shield)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.syncItem",
        "title": "Copy to Another Assistant / Scope...",
        "icon": "$(sync)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.createArtifact",
        "title": "Create New Artifact",
        "icon": "$(new-file)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.editArtifact",
        "title": "Edit Artifact",
        "icon": "$(edit)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.recommendForWorkspace",
        "title": "Recommend for Workspace",
        "icon": "$(star)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.unrecommendForWorkspace",
        "title": "Unrecommend from Workspace",
        "icon": "$(star-empty)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.openDashboard",
        "title": "Open Dashboard",
        "icon": "$(dashboard)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installRecommended",
        "title": "Install Recommended",
        "icon": "$(sparkle)",
        "category": "AI Swissknife"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiSwissknife.openDashboard",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.openDashboard",
          "when": "view == aiSwissknife.available",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.openDashboard",
          "when": "view == aiSwissknife.installed",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.addSource",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@1"
        },
        {
          "command": "aiSwissknife.reloadRegistry",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@2"
        },
        {
          "command": "aiSwissknife.installRecommended",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@3"
        },
        {
          "command": "aiSwissknife.refreshCatalog",
          "when": "view == aiSwissknife.available",
          "group": "navigation@1"
        },
        {
          "command": "aiSwissknife.createArtifact",
          "when": "view == aiSwissknife.installed",
          "group": "navigation@1"
        },
        {
          "command": "aiSwissknife.checkDrift",
          "when": "view == aiSwissknife.installed",
          "group": "navigation@2"
        },
        {
          "command": "aiSwissknife.refreshInstalled",
          "when": "view == aiSwissknife.installed",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "aiSwissknife.installArtifact",
          "when": "view == aiSwissknife.available && viewItem =~ /^availableArtifact/",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.installFolder",
          "when": "view == aiSwissknife.available && viewItem == availableFolder",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.installSourceGroup",
          "when": "view == aiSwissknife.available && viewItem == availableSourceGroup",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.updateItem",
          "when": "view == aiSwissknife.installed && viewItem =~ /^installedInstallation/",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.syncItem",
          "when": "view == aiSwissknife.installed && viewItem =~ /^installedInstallation/",
          "group": "inline@2"
        },
        {
          "command": "aiSwissknife.syncItem",
          "when": "view == aiSwissknife.installed && viewItem == observedArtifactItem",
          "group": "inline@2"
        },
        {
          "command": "aiSwissknife.editArtifact",
          "when": "view == aiSwissknife.installed && viewItem =~ /^installedInstallation/",
          "group": "inline@3"
        },
        {
          "command": "aiSwissknife.editArtifact",
          "when": "view == aiSwissknife.installed && viewItem == observedArtifactItem",
          "group": "inline@3"
        },
        {
          "command": "aiSwissknife.recommendForWorkspace",
          "when": "view == aiSwissknife.available && viewItem =~ /^availableArtifact/ && viewItem != availableArtifact:recommended",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.unrecommendForWorkspace",
          "when": "view == aiSwissknife.available && viewItem == availableArtifact:recommended",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.recommendForWorkspace",
          "when": "view == aiSwissknife.installed && viewItem =~ /^installedInstallation/ && viewItem != installedInstallation:recommended",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.unrecommendForWorkspace",
          "when": "view == aiSwissknife.installed && viewItem == installedInstallation:recommended",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.promoteItem",
          "when": "view == aiSwissknife.installed && viewItem == observedArtifactItem",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.removeSource",
          "when": "view == aiSwissknife.sources && viewItem == sourceItem",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test out"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.19.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  }
}
