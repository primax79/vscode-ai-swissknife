{
  "name": "ai-swissknife",
  "displayName": "AI Swissknife",
  "description": "Cross-assistant marketplace and management for custom skill/agent/mcp/rule repositories (Claude Code, Kilo Code, and more).",
  "version": "0.7.1",
  "publisher": "AlfredoOliviero",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/primax79/vscode-ai-swissknife.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "ai-swissknife": "./dist/cli.js"
  },
  "contributes": {
    "configuration": {
      "title": "AI Swissknife",
      "properties": {
        "aiSwissknife.enabledAssistants": {
          "type": "object",
          "description": "Which AI assistants show their own sidebar section and appear in assistant pickers.",
          "additionalProperties": false,
          "properties": {
            "claude-code": {
              "type": "boolean",
              "default": true,
              "description": "Claude Code"
            },
            "kilo-code": {
              "type": "boolean",
              "default": true,
              "description": "Kilo Code"
            },
            "github-copilot": {
              "type": "boolean",
              "default": true,
              "description": "GitHub Copilot"
            },
            "codex-cli": {
              "type": "boolean",
              "default": true,
              "description": "Codex CLI"
            },
            "gemini-cli": {
              "type": "boolean",
              "default": true,
              "description": "Gemini CLI"
            }
          },
          "default": {
            "claude-code": true,
            "kilo-code": true,
            "github-copilot": true,
            "codex-cli": true,
            "gemini-cli": true
          }
        }
      }
    },
    "icons": {
      "ai-swissknife-claude-code": {
        "description": "Claude Code",
        "default": {
          "fontPath": "resources/icon-font/ai-swissknife-icons.woff",
          "fontCharacter": "\\f105"
        }
      },
      "ai-swissknife-kilo-code": {
        "description": "Kilo Code",
        "default": {
          "fontPath": "resources/icon-font/ai-swissknife-icons.woff",
          "fontCharacter": "\\f101"
        }
      },
      "ai-swissknife-github-copilot": {
        "description": "GitHub Copilot",
        "default": {
          "fontPath": "resources/icon-font/ai-swissknife-icons.woff",
          "fontCharacter": "\\f102"
        }
      },
      "ai-swissknife-codex-cli": {
        "description": "Codex CLI",
        "default": {
          "fontPath": "resources/icon-font/ai-swissknife-icons.woff",
          "fontCharacter": "\\f104"
        }
      },
      "ai-swissknife-gemini-cli": {
        "description": "Gemini CLI",
        "default": {
          "fontPath": "resources/icon-font/ai-swissknife-icons.woff",
          "fontCharacter": "\\f103"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-swissknife",
          "title": "AI Swissknife",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-swissknife": [
        {
          "id": "aiSwissknife.sources",
          "name": "Sources"
        },
        {
          "id": "aiSwissknife.installed.claude-code",
          "name": "Claude Code",
          "when": "aiSwissknife.enabled.claude-code"
        },
        {
          "id": "aiSwissknife.installed.kilo-code",
          "name": "Kilo Code",
          "when": "aiSwissknife.enabled.kilo-code"
        },
        {
          "id": "aiSwissknife.installed.github-copilot",
          "name": "GitHub Copilot",
          "when": "aiSwissknife.enabled.github-copilot"
        },
        {
          "id": "aiSwissknife.installed.codex-cli",
          "name": "Codex CLI",
          "when": "aiSwissknife.enabled.codex-cli"
        },
        {
          "id": "aiSwissknife.installed.gemini-cli",
          "name": "Gemini CLI",
          "when": "aiSwissknife.enabled.gemini-cli"
        }
      ]
    },
    "commands": [
      {
        "command": "aiSwissknife.configureEnabledAssistants",
        "title": "Configure Enabled Assistants...",
        "icon": "$(gear)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.addSource",
        "title": "Add Source",
        "icon": "$(plus)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.removeSource",
        "title": "Remove Source",
        "icon": "$(trash)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.reloadRegistry",
        "title": "Reload Manifest",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.exportConfig",
        "title": "Export Configuration...",
        "icon": "$(export)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.importConfig",
        "title": "Import Configuration...",
        "icon": "$(desktop-download)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.exportSource",
        "title": "Export Source...",
        "icon": "$(export)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.refreshCatalog",
        "title": "Refresh Available Catalog",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.refreshSource",
        "title": "Refresh Source",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installArtifact",
        "title": "Install Skill",
        "icon": "$(cloud-download)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.previewAvailableArtifact",
        "title": "Preview File",
        "icon": "$(eye)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installFolder",
        "title": "Install All in Folder",
        "icon": "$(cloud-download)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installSourceGroup",
        "title": "Install All in Source",
        "icon": "$(cloud-download)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.refreshInstalled",
        "title": "Refresh Installed",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.checkDrift",
        "title": "Check Drift & Updates",
        "icon": "$(sync)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.updateAll",
        "title": "Update All...",
        "icon": "$(arrow-circle-up)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.updateItem",
        "title": "Update to Latest Version",
        "icon": "$(arrow-circle-up)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.holdItem",
        "title": "Hold",
        "icon": "$(pin)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.releaseItem",
        "title": "Release",
        "icon": "$(pinned)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.relinkItem",
        "title": "Re-link to Source...",
        "icon": "$(link)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.reinstallItem",
        "title": "Reinstall",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.diffAgainstOriginal",
        "title": "Diff vs. Original",
        "icon": "$(diff)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.promoteItem",
        "title": "Promote to Managed",
        "icon": "$(shield)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.syncItem",
        "title": "Copy to Another Assistant / Scope...",
        "icon": "$(sync)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.moveItem",
        "title": "Move to Another Assistant / Scope...",
        "icon": "$(arrow-right)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.uninstallItem",
        "title": "Uninstall",
        "icon": "$(trash)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.createArtifact",
        "title": "Create New Artifact",
        "icon": "$(new-file)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.editArtifact",
        "title": "Edit Artifact",
        "icon": "$(edit)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.recommendForWorkspace",
        "title": "Recommend for Workspace",
        "icon": "$(star-empty)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.unrecommendForWorkspace",
        "title": "Unrecommend from Workspace",
        "icon": "$(star-full)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.openDashboard",
        "title": "Open Dashboard",
        "icon": "$(dashboard)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.openInDashboard",
        "title": "Open in Dashboard",
        "icon": "$(dashboard)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installRecommended",
        "title": "Install Recommended",
        "icon": "$(sparkle)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.restoreFromTrash",
        "title": "Restore from Trash...",
        "icon": "$(history)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.emptyTrash",
        "title": "Empty Trash...",
        "icon": "$(clear-all)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.pruneMissing",
        "title": "Prune Missing Installations from Registry",
        "icon": "$(trash)",
        "category": "AI Swissknife"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aiSwissknife.refreshSource",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "aiSwissknife.openDashboard",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.openDashboard",
          "when": "view =~ /^aiSwissknife\\.installed/",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.addSource",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@1"
        },
        {
          "command": "aiSwissknife.reloadRegistry",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@2"
        },
        {
          "command": "aiSwissknife.installRecommended",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@3"
        },
        {
          "command": "aiSwissknife.refreshCatalog",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@4"
        },
        {
          "command": "aiSwissknife.exportConfig",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@5"
        },
        {
          "command": "aiSwissknife.importConfig",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@6"
        },
        {
          "command": "aiSwissknife.updateAll",
          "when": "view == aiSwissknife.installed.claude-code && aiSwissknife.updatesAvailable.claude-code",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.updateAll",
          "when": "view == aiSwissknife.installed.kilo-code && aiSwissknife.updatesAvailable.kilo-code",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.updateAll",
          "when": "view == aiSwissknife.installed.github-copilot && aiSwissknife.updatesAvailable.github-copilot",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.updateAll",
          "when": "view == aiSwissknife.installed.codex-cli && aiSwissknife.updatesAvailable.codex-cli",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.updateAll",
          "when": "view == aiSwissknife.installed.gemini-cli && aiSwissknife.updatesAvailable.gemini-cli",
          "group": "navigation@0"
        },
        {
          "command": "aiSwissknife.createArtifact",
          "when": "view =~ /^aiSwissknife\\.installed/",
          "group": "navigation@1"
        },
        {
          "command": "aiSwissknife.checkDrift",
          "when": "view =~ /^aiSwissknife\\.installed/",
          "group": "navigation@2"
        },
        {
          "command": "aiSwissknife.refreshInstalled",
          "when": "view =~ /^aiSwissknife\\.installed/",
          "group": "navigation@3"
        },
        {
          "command": "aiSwissknife.restoreFromTrash",
          "when": "view =~ /^aiSwissknife\\.installed/",
          "group": "navigation@4"
        },
        {
          "command": "aiSwissknife.emptyTrash",
          "when": "view =~ /^aiSwissknife\\.installed/",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "aiSwissknife.installArtifact",
          "when": "view == aiSwissknife.sources && viewItem =~ /^availableArtifact/",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.previewAvailableArtifact",
          "when": "view == aiSwissknife.sources && viewItem =~ /^availableArtifact/",
          "group": "inline@2"
        },
        {
          "command": "aiSwissknife.installFolder",
          "when": "view == aiSwissknife.sources && viewItem == availableFolder",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.updateItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.diffAgainstOriginal",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation.*:(modified-locally|modified-and-update-available)/",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.diffAgainstOriginal",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^observedArtifactItem.*:different/",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.syncItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/",
          "group": "inline@2"
        },
        {
          "command": "aiSwissknife.moveItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/",
          "group": "inline@2"
        },
        {
          "command": "aiSwissknife.syncItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem == observedArtifactItem",
          "group": "inline@2"
        },
        {
          "command": "aiSwissknife.editArtifact",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/",
          "group": "inline@3"
        },
        {
          "command": "aiSwissknife.editArtifact",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem == observedArtifactItem",
          "group": "inline@3"
        },
        {
          "command": "aiSwissknife.recommendForWorkspace",
          "when": "view == aiSwissknife.sources && viewItem =~ /^availableArtifact/ && viewItem != availableArtifact:recommended",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.unrecommendForWorkspace",
          "when": "view == aiSwissknife.sources && viewItem == availableArtifact:recommended",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.recommendForWorkspace",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/ && viewItem != installedInstallation:recommended",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.unrecommendForWorkspace",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem == installedInstallation:recommended",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.uninstallItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/",
          "group": "inline@5"
        },
        {
          "command": "aiSwissknife.holdItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/ && !(viewItem =~ /:held/)",
          "group": "2_hold@1"
        },
        {
          "command": "aiSwissknife.relinkItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/",
          "group": "2_hold@2"
        },
        {
          "command": "aiSwissknife.reinstallItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation/",
          "group": "2_hold@3"
        },
        {
          "command": "aiSwissknife.releaseItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem =~ /^installedInstallation.*:held/",
          "group": "inline@6"
        },
        {
          "command": "aiSwissknife.promoteItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem == observedArtifactItem:one",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.promoteItem",
          "when": "view =~ /^aiSwissknife\\.installed/ && viewItem == observedArtifactItem:many",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.refreshSource",
          "when": "view == aiSwissknife.sources && viewItem == sourceItem",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.installSourceGroup",
          "when": "view == aiSwissknife.sources && viewItem == sourceItem",
          "group": "inline@2"
        },
        {
          "command": "aiSwissknife.removeSource",
          "when": "view == aiSwissknife.sources && viewItem == sourceItem",
          "group": "inline@3"
        },
        {
          "command": "aiSwissknife.openInDashboard",
          "when": "view == aiSwissknife.sources && viewItem == sourceItem",
          "group": "inline@4"
        },
        {
          "command": "aiSwissknife.exportSource",
          "when": "view == aiSwissknife.sources && viewItem == sourceItem",
          "group": "inline@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "dev:ui": "node esbuild.config.js && node --watch dist/standalone.js",
    "generate-icon-font": "fantasticon resources/icon-font/svg -o resources/icon-font -n ai-swissknife-icons -t woff -g json --normalize true",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.config.js && tsc && node --test out",
    "test:isolated": "node scripts/test-isolated.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.19.0",
    "eslint": "^8.54.0",
    "fantasticon": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
