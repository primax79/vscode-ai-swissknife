{
  "name": "ai-swissknife",
  "displayName": "AI Swissknife",
  "description": "Cross-assistant marketplace and management for custom skill/agent/mcp/rule repositories (Claude Code, Kilo Code, and more).",
  "version": "0.0.1",
  "publisher": "TODO-set-before-publish",
  "repository": {
    "type": "git",
    "url": "git@github.com:primax79/vscode-ai-swissknife.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-swissknife",
          "title": "AI Swissknife",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-swissknife": [
        {
          "id": "aiSwissknife.sources",
          "name": "Sources"
        },
        {
          "id": "aiSwissknife.available",
          "name": "Available"
        },
        {
          "id": "aiSwissknife.installed",
          "name": "Installed"
        }
      ]
    },
    "commands": [
      {
        "command": "aiSwissknife.addSource",
        "title": "Add Source",
        "icon": "$(plus)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.removeSource",
        "title": "Remove Source",
        "icon": "$(trash)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.reloadRegistry",
        "title": "Reload Manifest",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.refreshCatalog",
        "title": "Refresh Available Catalog",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.installArtifact",
        "title": "Install Skill",
        "icon": "$(cloud-download)",
        "category": "AI Swissknife"
      },
      {
        "command": "aiSwissknife.refreshInstalled",
        "title": "Refresh Installed",
        "icon": "$(refresh)",
        "category": "AI Swissknife"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiSwissknife.addSource",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@1"
        },
        {
          "command": "aiSwissknife.reloadRegistry",
          "when": "view == aiSwissknife.sources",
          "group": "navigation@2"
        },
        {
          "command": "aiSwissknife.refreshCatalog",
          "when": "view == aiSwissknife.available",
          "group": "navigation@1"
        },
        {
          "command": "aiSwissknife.refreshInstalled",
          "when": "view == aiSwissknife.installed",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aiSwissknife.installArtifact",
          "when": "view == aiSwissknife.available && viewItem == availableArtifact",
          "group": "inline@1"
        },
        {
          "command": "aiSwissknife.removeSource",
          "when": "view == aiSwissknife.sources && viewItem == sourceItem",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test out"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.19.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  }
}
